    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "xlsx": "^0.18.5"
  },
  "description": "XLSX to beautiful PDF in pure JavaScript. Evaluates uncached formulas on-device, typesets wide sheets, draws the PDF directly. No browser, no server, no native code. Runs in Node, browsers, and AWS Lambda.",
