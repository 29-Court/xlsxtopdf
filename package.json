    "node": ">=16"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs",
      "require": "./src/index.cjs",
      "default": "./src/index.cjs"
    }
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://29court.com",
  "keywords": [
    "xlsx",
    "excel",
    "pdf",
    "converter",
    "spreadsheet",
    "lambda",
    "serverless",
    "formulas"
  ],
  "license": "MIT",
  "main": "src/index.cjs",
  "name": "@29court/xlsxtopdf",
  "repository": {
    "type": "git",
    "url": "https://github.com/valgaze/29court-brains.git"
  },
